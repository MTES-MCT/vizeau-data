# Credentials S3 (Scaleway ou tout stockage compatible S3)
# Exemple Scaleway Paris : https://s3.fr-par.scw.cloud
S3_ENDPOINT=
S3_REGION=fr-par
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Bucket source des shapefiles RPG (pipeline-shapefiles.yaml uniquement).
# Même compte/credentials que ci-dessus, bucket différent.
S3_SOURCE_BUCKET=
